<?xml version="1.0" encoding="UTF-8"?>
<!--
  Black and white editor scheme, matching configs/wofi/themes/minimal.css
  and themes/wayle/minimal (black, white, #333333).

  VCR OSD Mono is Regular-only. Bold and italic make GTK substitute
  another face, so syntax is told apart with gray weight only.
-->
<style-scheme id="minimal" name="Minimal" kind="dark">
  <description>Black and white, matching the minimal wofi theme.</description>

  <color name="black"  value="#000000"/>
  <color name="white"  value="#ffffff"/>
  <color name="border" value="#333333"/>
  <color name="dim"    value="#666666"/>
  <color name="soft"   value="#cccccc"/>
  <color name="line"   value="#111111"/>

  <style name="text"                 foreground="white" background="black"/>
  <style name="selection"            foreground="black" background="white"/>
  <style name="cursor"               foreground="white"/>
  <style name="secondary-cursor"     foreground="dim"/>
  <style name="current-line"         background="line"/>
  <style name="current-line-number"  foreground="white" background="black"/>
  <style name="line-numbers"         foreground="dim" background="black"/>
  <style name="draw-spaces"          foreground="border"/>
  <style name="background-pattern"   background="line"/>

  <style name="bracket-match"        foreground="white" background="border"/>
  <style name="bracket-mismatch"     foreground="black" background="white"/>
  <style name="right-margin"         foreground="border" background="border"/>
  <style name="search-match"         foreground="white" background="border"/>

  <style name="def:comment"              foreground="dim"/>
  <style name="def:shebang"              foreground="dim"/>
  <style name="def:doc-comment-element"  foreground="soft"/>

  <style name="def:constant"         foreground="soft"/>
  <style name="def:string"           foreground="soft"/>
  <style name="def:special-char"     foreground="white"/>
  <style name="def:special-constant" foreground="white"/>
  <style name="def:number"           foreground="soft"/>
  <style name="def:floating-point"   foreground="soft"/>

  <style name="def:identifier"       foreground="white"/>
  <style name="def:function"         foreground="white"/>
  <style name="def:statement"        foreground="white"/>
  <style name="def:type"             foreground="white"/>
  <style name="def:preprocessor"     foreground="soft"/>

  <style name="def:error"            foreground="black" background="white"/>
  <style name="def:warning"          underline="single"/>
  <style name="def:note"             foreground="white" underline="single"/>
  <style name="def:underlined"       underline="single"/>

  <style name="diff:added-line"      foreground="white"/>
  <style name="diff:removed-line"    foreground="dim"/>
  <style name="diff:changed-line"    foreground="soft"/>
  <style name="diff:diff-file"       foreground="white"/>
  <style name="diff:location"        foreground="soft"/>
  <style name="diff:special-case"    foreground="white"/>
</style-scheme>
