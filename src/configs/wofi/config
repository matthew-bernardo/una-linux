# Wofi. ONLY style.css is loaded at runtime (not themes/*).
# Edit style.css, then: cp ~/.una/una-linux/src/configs/wofi/style.css ~/.config/wofi/style.css
# themes/minimal.css is a backup copy of that look; tokyo-* are for toggleTerminalTheme.
allow_images=true
allow_markup=true
hide_scroll=true
image_size=24
insensitive=true
location=center
matching=fuzzy
no_actions=true
orientation=vertical
prompt=Search
# Same aspect ratio as the screen (equal % of both axes).
width=50%
height=50%
