#!/usr/bin/env bash
# Wayle custom-module helper for the screen-recording button.
# idle "rec" -> countdown "3..."/"2..."/"1..." -> "REC", then stop + save.
# Records the compositor via wf-recorder (Wayland) plus the default mic.
set -euo pipefail

STATE_DIR="${WAYLE_REC_DIR:-${XDG_RUNTIME_DIR:-/tmp}/wayle-rec}"
STATE_FILE="${STATE_DIR}/state"
LOCK_FILE="${STATE_DIR}/lock"
PID_FILE="${STATE_DIR}/recorder.pid"
TMP_FILE="${STATE_DIR}/in-progress.mp4"
LOG_FILE="${STATE_DIR}/recorder.log"
COUNTDOWN_SECS=3
POLL_SEC=0.1
RECORDER_BIN="${WAYLE_REC_RECORDER:-wf-recorder}"

usage() {
  echo "usage: wayle_rec [status|watch|toggle]" >&2
  exit 2
}

recordings_dir() {
  if [[ -n "${WAYLE_REC_VIDEOS_DIR:-}" ]]; then
    printf '%s' "${WAYLE_REC_VIDEOS_DIR}"
    return
  fi
  local videos="${HOME}/Videos"
  if command -v xdg-user-dir >/dev/null 2>&1; then
    videos="$(xdg-user-dir VIDEOS)"
  fi
  printf '%s' "${videos}/ScreenRecordings"
}

suggested_filename() {
  printf 'screc-%s.mp4' "$(date +%Y%m%d-%H%M%S)"
}

sanitize_filename() {
  local name="$1"
  name="${name//$'\r'/}"
  name="${name#"${name%%[![:space:]]*}"}"
  name="${name%"${name##*[![:space:]]}"}"
  name="${name##*/}"
  if [[ -z "${name}" || "${name}" == "." || "${name}" == ".." ]]; then
    return 1
  fi
  printf '%s' "${name}"
}

prompt_filename() {
  if [[ -v WAYLE_REC_NAME ]]; then
    printf '%s' "${WAYLE_REC_NAME}"
    return
  fi

  local suggested
  suggested="$(suggested_filename)"
  command -v wofi >/dev/null 2>&1 || {
    printf '%s' "${suggested}"
    return
  }

  ensure_dir
  local -a cmd=(
    wofi
    --dmenu
    --prompt "Save recording as"
    --search "${suggested}"
    --exec-search
    --cache-file "${STATE_DIR}/wofi-save-cache"
    --lines 1
  )
  if [[ -f "${HOME}/.config/wofi/style.css" ]]; then
    cmd+=(--style "${HOME}/.config/wofi/style.css")
  fi

  local chosen=""
  chosen="$("${cmd[@]}" </dev/null)" || true
  printf '%s' "${chosen}"
}

notify_saved() {
  local path="$1"
  if command -v notify-send >/dev/null 2>&1; then
    notify-send --app-name=wayle-rec "Recording saved" "${path}" || true
  fi
}

notify_error() {
  local message="$1"
  if command -v notify-send >/dev/null 2>&1; then
    notify-send --app-name=wayle-rec "Recording failed" "${message}" || true
  fi
}

recorder_pid() {
  if [[ -f "${PID_FILE}" ]]; then
    local pid=""
    IFS= read -r pid <"${PID_FILE}" || true
    printf '%s' "${pid}"
  fi
}

recorder_running() {
  local pid
  pid="$(recorder_pid)"
  [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null
}

start_recorder() {
  ensure_dir
  if recorder_running; then
    return 0
  fi
  if ! command -v "${RECORDER_BIN}" >/dev/null 2>&1; then
    notify_error "Install wf-recorder to record the screen"
    return 1
  fi

  rm -f "${TMP_FILE}" "${PID_FILE}"
  : >"${LOG_FILE}"

  # Write $$ from inside the new session so we track wf-recorder, not a
  # short-lived setsid parent. Background job control makes `&` a pgroup
  # leader; setsid -f always forks a real session around the recorder.
  setsid -f /bin/bash -c '
    printf "%s\n" "$$" >"$1"
    exec "$2" -a -f "$3" -y -c libx264 -p preset=veryfast -x yuv420p >>"$4" 2>&1
  ' wayle-rec-recorder "${PID_FILE}" "${RECORDER_BIN}" "${TMP_FILE}" "${LOG_FILE}" </dev/null

  local i pid=""
  for i in $(seq 1 25); do
    if [[ -f "${PID_FILE}" ]]; then
      pid="$(recorder_pid)"
      if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
        return 0
      fi
    fi
    sleep 0.1
  done

  notify_error "$(recorder_failure_message "wf-recorder failed to start")"
  rm -f "${PID_FILE}"
  return 1
}

stop_recorder() {
  local pid i
  pid="$(recorder_pid)"
  if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
    kill -INT "${pid}" 2>/dev/null || true
    for i in $(seq 1 80); do
      kill -0 "${pid}" 2>/dev/null || break
      sleep 0.1
    done
    if kill -0 "${pid}" 2>/dev/null; then
      kill -TERM "${pid}" 2>/dev/null || true
      sleep 0.4
    fi
  fi
  rm -f "${PID_FILE}"
}

recorder_failure_message() {
  local fallback="$1"
  local detail=""
  if [[ -s "${LOG_FILE}" ]]; then
    detail="$(tail -n 3 "${LOG_FILE}" | tr '\n' ' ')"
    detail="${detail%" "}"
  fi
  if [[ -n "${detail}" ]]; then
    printf '%s' "${detail}"
  else
    printf '%s' "${fallback}"
  fi
}

save_recording() {
  stop_recorder

  if [[ ! -s "${TMP_FILE}" ]]; then
    notify_error "$(recorder_failure_message "No video was captured")"
    rm -f "${TMP_FILE}"
    return 0
  fi

  local raw chosen dest dir
  raw="$(prompt_filename)"
  if ! chosen="$(sanitize_filename "${raw}")"; then
    chosen="$(suggested_filename)"
  fi

  dir="$(recordings_dir)"
  mkdir -p "${dir}"
  dest="${dir}/${chosen}"
  mv -f "${TMP_FILE}" "${dest}"
  notify_saved "${dest}"
}

ensure_dir() {
  mkdir -p "${STATE_DIR}"
}

now() {
  printf '%s' "${EPOCHREALTIME}"
}

elapsed_secs() {
  local start="$1"
  awk -v now="${EPOCHREALTIME}" -v start="${start}" 'BEGIN {
    e = now - start
    if (e < 0) e = 0
    printf "%d", e
  }'
}

read_state() {
  if [[ -f "${STATE_FILE}" ]]; then
    local line=""
    IFS= read -r line <"${STATE_FILE}" || true
    printf '%s' "${line}"
  else
    printf 'idle'
  fi
}

write_state() {
  ensure_dir
  local tmp
  tmp="$(mktemp "${STATE_DIR}/.state.XXXXXX")"
  printf '%s\n' "$1" >"${tmp}"
  mv -f "${tmp}" "${STATE_FILE}"
}

run_locked() {
  ensure_dir
  {
    flock 9
    "$@"
  } 9>"${LOCK_FILE}"
}

emit_json() {
  local text="$1"
  local class="$2"
  local tooltip="$3"
  if [[ -n "${class}" ]]; then
    printf '{"text":"%s","class":"%s","tooltip":"%s"}\n' "${text}" "${class}" "${tooltip}"
  else
    printf '{"text":"%s","tooltip":"%s"}\n' "${text}" "${tooltip}"
  fi
}

render() {
  local raw="$1"
  local kind="${raw%% *}"
  local rest="${raw#* }"

  case "${kind}" in
    countdown)
      local elapsed
      elapsed="$(elapsed_secs "${rest}")"
      if ((elapsed >= COUNTDOWN_SECS)); then
        emit_json "REC" "rec-active" "Stop screen recording"
      else
        emit_json "$((COUNTDOWN_SECS - elapsed))..." "rec-active" "Starting…"
      fi
      ;;
    recording)
      emit_json "REC" "rec-active" "Stop screen recording"
      ;;
    *)
      emit_json "rec" "" "Start screen recording"
      ;;
  esac
}

_set_idle() {
  write_state "idle"
}

promote_if_due() {
  local action=""
  action="$(run_locked _promote_locked)"
  if [[ "${action}" == start ]]; then
    if ! start_recorder; then
      run_locked _set_idle
    fi
  fi
}

_promote_locked() {
  local raw
  raw="$(read_state)"
  if [[ "${raw}" == countdown* ]]; then
    local start="${raw#* }"
    local elapsed
    elapsed="$(elapsed_secs "${start}")"
    if ((elapsed >= COUNTDOWN_SECS)); then
      write_state "recording"
      printf 'start'
    fi
  fi
}

cmd_status() {
  promote_if_due
  render "$(read_state)"
}

cmd_watch() {
  if [[ -z "${WAYLE_REC_STDBUF:-}" ]] && command -v stdbuf >/dev/null 2>&1; then
    exec env WAYLE_REC_STDBUF=1 stdbuf -oL -eL "$0" watch
  fi

  local last="" line
  while true; do
    promote_if_due
    line="$(render "$(read_state)")"
    if [[ "${line}" != "${last}" ]]; then
      printf '%s\n' "${line}"
      last="${line}"
    fi
    sleep "${POLL_SEC}"
  done
}

cmd_toggle() {
  local action=""
  action="$(run_locked _toggle_locked)"
  if [[ "${action}" == save ]]; then
    save_recording
  fi
}

_toggle_locked() {
  local raw kind
  raw="$(read_state)"
  kind="${raw%% *}"
  case "${kind}" in
    idle | "")
      write_state "countdown $(now)"
      ;;
    recording)
      write_state "idle"
      printf 'save'
      ;;
    countdown)
      # Ignore clicks until the countdown becomes REC.
      ;;
    *)
      write_state "idle"
      ;;
  esac
}

case "${1:-status}" in
  status) cmd_status ;;
  watch) cmd_watch ;;
  toggle) cmd_toggle ;;
  -h | --help | help) usage ;;
  *) usage ;;
esac
